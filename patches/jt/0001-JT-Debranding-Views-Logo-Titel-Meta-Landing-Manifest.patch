+# frozen_string_literal: true
+
+# JT-Branding (gemountet aus /root/docuseal/branding, siehe README.md)
+Rails.application.config.to_prepare do
+  Docuseal.singleton_class.send(:define_method, :product_name) { 'Jason Talge Signatur' }
+end
+
+Rails.application.config.after_initialize do
+  I18n.backend.store_translations(:en, welcome_to_docuseal: 'Welcome to Jason Talge Signatur')
+  I18n.backend.store_translations(:de, welcome_to_docuseal: 'Willkommen bei Jason Talge Signatur')
+end

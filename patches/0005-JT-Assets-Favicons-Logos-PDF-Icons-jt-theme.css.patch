diff --git a/public/jt/jt-theme-light.css b/public/jt/jt-theme-light.css
new file mode 100644
index 0000000..a0bbfea
--- /dev/null
+++ b/public/jt/jt-theme-light.css
@@ -0,0 +1,23 @@
+/* JT-Farben fuer DocuSeal (daisyUI-HSL-Variablen). html:root schlaegt das
+   spaeter geladene :root der Packs (hoehere Spezifitaet). Quelle: ~/Logo_Jason_Talge
+   Talge Blau #123E6B, Tiefblau #0B2A4A, Anthrazit #2B2F36 */
+html:root {
+  --n: 211 71% 25%;   /* Talge Blau: Haupt-Buttons, dunkle Flaechen */
+  --nf: 210 74% 17%;  /* Tiefblau: Hover */
+  --nc: 0 0% 100%;
+  --p: 213 30% 90%;   /* helles Blaugrau statt Rosa-Grau */
+  --pf: 213 30% 83%;
+  --pc: 218 11% 19%;
+  --s: 211 55% 78%;
+  --sf: 211 55% 70%;
+  --sc: 210 74% 17%;
+  --a: 207 64% 47%;   /* Akzent: helleres Talge Blau */
+  --af: 207 64% 40%;
+  --ac: 0 0% 100%;
+  --b1: 216 33% 97%;  /* kuehles Off-White statt Beige */
+  --b2: 214 30% 92%;
+  --b3: 214 25% 87%;
+  --bc: 218 11% 19%;  /* Anthrazit */
+}
+/* Avatar-Initialen in der Navbar (sonst lila) */
+label.bg-base-content.text-purple-300 { color: #9EC3E8; }
diff --git a/public/jt/jt-theme.css b/public/jt/jt-theme.css
new file mode 100644
index 0000000..2e17029
--- /dev/null
+++ b/public/jt/jt-theme.css
@@ -0,0 +1,79 @@
+/* JT Dark-Mode-Ergaenzungen fuer DocuSeal. Die Grundfarben kommen seit dem eigenen
+   Image aus dem daisyUI-Theme "jt" (tailwind.config.js, Patch 0002). Hier nur noch
+   Korrekturen fuer fest verdrahtete helle Klassen. Helle Variante: jt-theme-light.css
+   (setzt die Variablen per html:root wieder hell). */
+
+/* Fest verdrahtete helle Formularelemente -> dunkle Inputs */
+.base-input, .base-select, .base-textarea, .autocomplete, .white-button,
+.base-checkbox, .base-radio {
+  background-color: #123659 !important;
+  color: hsl(var(--bc)) !important;
+}
+.base-input::placeholder, .base-textarea::placeholder { color: #7F95AD; }
+
+/* Helle Grau-Flaechen */
+.bg-gray-50, .bg-gray-100, .bg-neutral-100 { background-color: hsl(var(--b2)) !important; }
+.bg-gray-200, .bg-neutral-200 { background-color: hsl(var(--b3)) !important; }
+.hover\:bg-neutral-100:hover, .hover\:bg-neutral-200:hover, .hover\:bg-white:hover { background-color: hsl(var(--b3)) !important; }
+.border-gray-300, .border-neutral-200, .border-neutral-300 { border-color: hsl(var(--b3)) !important; }
+
+/* Dunkle Grau-Texte lesbar machen */
+.text-gray-900, .text-gray-700 { color: hsl(var(--bc)) !important; }
+.text-gray-600 { color: #B4C3D4 !important; }
+.text-gray-500 { color: #95A8BD !important; }
+
+/* Avatar-Initialen (bg-base-content ist jetzt hell) */
+label.bg-base-content.text-purple-300 { color: #0B2A4A; }
+
+/* Unterschrifts-/Kuerzel-Canvas und PDF-Seiten bleiben bewusst weiss (.bg-white) */
+
+/* ---- Dark-Fixes 2026-10-23 (Runde 2) ---- */
+
+/* PDF-Seiten = Papier: dort gilt die helle Palette, damit Feldwerte, Feld-Labels
+   und Menues auf der Seite dunkle Schrift auf Weiss behalten */
+page-container, [style*="container-type: size"] {
+  color-scheme: light;
+  --b1: 216 33% 97%; --b2: 214 30% 92%; --b3: 214 25% 87%; --bc: 218 11% 19%;
+  --n: 211 71% 25%; --nf: 210 74% 17%; --nc: 0 0% 100%;
+  --p: 213 30% 90%; --pf: 213 30% 83%; --pc: 218 11% 19%;
+  --s: 211 55% 78%; --sf: 211 55% 70%; --sc: 210 74% 17%;
+  --a: 207 64% 47%; --af: 207 64% 40%; --ac: 0 0% 100%;
+  color: hsl(var(--bc));
+}
+
+/* bg-white ausserhalb der Seiten (Kontextmenues, Dropdowns, Outline-Buttons,
+   Template-Builder-Leisten) -> dunkel. Weiss bleiben: Canvas, Bilder,
+   Unterschriftsflaechen, QR-Box, Schwaerzungs-Rechtecke, dynamische Abschnitte */
+.bg-white:not(canvas):not(img):not(.draw-canvas):not(:has(> canvas))
+  :not([style*="left:"]):not(.select-none.mb-4):not(.absolute.m-0\.5)
+  :not(page-container *):not([style*="container-type: size"] *) {
+  background-color: hsl(var(--b2)) !important;
+}
+.btn-outline.bg-white:not(page-container *):hover { background-color: hsl(var(--bc)) !important; }
+
+/* Pastell-Hinweisflaechen/Chips -> transparente Toenung statt hellem Kasten */
+:is(.bg-yellow-100,.bg-yellow-200,.bg-amber-100):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(234 179 8 / .18) !important; }
+:is(.bg-red-50,.bg-red-100,.bg-red-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(239 68 68 / .18) !important; }
+:is(.bg-blue-50,.bg-sky-100,.bg-sky-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(14 165 233 / .18) !important; }
+:is(.bg-lime-50,.bg-lime-100,.bg-lime-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(132 204 22 / .18) !important; }
+:is(.bg-emerald-100,.bg-emerald-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(16 185 129 / .18) !important; }
+:is(.bg-cyan-100,.bg-cyan-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(6 182 212 / .18) !important; }
+:is(.bg-indigo-100,.bg-indigo-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(99 102 241 / .22) !important; }
+:is(.bg-purple-100,.bg-purple-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(147 51 234 / .22) !important; }
+:is(.bg-pink-100,.bg-pink-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(236 72 153 / .2) !important; }
+:is(.bg-orange-100,.bg-orange-200):not(page-container *):not([style*="container-type: size"] *) { background-color: rgb(249 115 22 / .2) !important; }
+.border-yellow-200:not(page-container *) { border-color: rgb(234 179 8 / .4) !important; }
+.border-red-100:not(page-container *) { border-color: rgb(239 68 68 / .4) !important; }
+
+/* Weitere dunkelgraue Texte */
+.text-neutral-700:not(page-container *), .text-neutral-500, .md\:text-neutral-500 { color: #95A8BD !important; }
+.border-neutral-400, .border-gray-400 { border-color: hsl(var(--b3)) !important; }
+
+/* Autocomplete-Liste */
+.autocomplete .group { background-color: hsl(var(--b3)) !important; }
+
+/* Onboarding-Tour (driver.js) */
+.driver-popover { background-color: hsl(var(--b2)) !important; color: hsl(var(--bc)) !important; }
+.driver-popover-footer button { background-color: hsl(var(--b3)) !important; color: hsl(var(--bc)) !important; text-shadow: none !important; }
+.driver-popover-progress-text, .driver-popover-close-btn { color: #95A8BD !important; }
+.driver-popover-arrow { border-color: hsl(var(--b2)) transparent transparent transparent; }

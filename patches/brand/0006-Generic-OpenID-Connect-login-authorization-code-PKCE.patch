diff --git a/app/controllers/oidc_sessions_controller.rb b/app/controllers/oidc_sessions_controller.rb
new file mode 100644
index 0000000..f52cb52
--- /dev/null
+++ b/app/controllers/oidc_sessions_controller.rb
@@ -0,0 +1,76 @@
+# frozen_string_literal: true
+
+# OpenID Connect login, see lib/oidc_login.rb (DocuSeal-Docker patch set).
+class OidcSessionsController < ApplicationController
+  STATE_TTL = 10.minutes
+
+  skip_before_action :authenticate_user!
+  skip_before_action :maybe_redirect_to_setup
+  skip_authorization_check
+
+  before_action :ensure_enabled
+
+  rate_limit to: 20, within: 5.minutes, by: -> { request.remote_ip }, with: lambda {
+    redirect_to new_user_session_path, alert: I18n.t(:too_many_requests_try_again_later)
+  }
+
+  def new
+    state = SecureRandom.urlsafe_base64(32)
+    nonce = SecureRandom.urlsafe_base64(32)
+    verifier = SecureRandom.urlsafe_base64(48)
+
+    session[:oidc_state] = { 'state' => state, 'nonce' => nonce, 'verifier' => verifier, 'at' => Time.current.to_i }
+
+    redirect_to OidcLogin.authorize_url(redirect_uri:, state:, nonce:, verifier:), allow_other_host: true
+  end
+
+  def callback
+    data = session.delete(:oidc_state)
+
+    return failed(:oidc_error_state) unless valid_state?(data)
+    return failed(:oidc_error_provider, params[:error]) if params[:error].present?
+
+    tokens = OidcLogin.exchange_code(params[:code].to_s, redirect_uri:, verifier: data['verifier'])
+    claims = OidcLogin.verify_id_token(tokens['id_token'], nonce: data['nonce'])
+
+    info = OidcLogin.userinfo(tokens['access_token'])
+    raise OidcLogin::Error, 'userinfo sub mismatch' if info['sub'].present? && info['sub'] != claims['sub']
+
+    user, error = OidcLogin.resolve_user(claims.merge(info.except('sub')))
+
+    return failed(error, claims['email']) unless user
+
+    sign_in(user)
+    session[OidcLogin::SESSION_KEY] = true
+
+    Rails.logger.info("[oidc] login user=#{user.id}")
+
+    redirect_to root_path
+  rescue OidcLogin::Error, JWT::DecodeError, Faraday::Error, JSON::ParserError => e
+    Rails.logger.warn("[oidc] login failed: #{e.class}: #{e.message}")
+
+    failed(:oidc_error_generic)
+  end
+
+  private
+
+  def ensure_enabled
+    head :not_found unless OidcLogin.enabled?
+  end
+
+  def redirect_uri
+    oidc_callback_url
+  end
+
+  def valid_state?(data)
+    data.is_a?(Hash) && params[:state].present? &&
+      ActiveSupport::SecurityUtils.secure_compare(params[:state].to_s, data['state'].to_s) &&
+      data['at'].to_i > STATE_TTL.ago.to_i
+  end
+
+  def failed(key, detail = nil)
+    Rails.logger.warn("[oidc] login rejected: #{key}#{" (#{detail})" if detail.present?}")
+
+    redirect_to new_user_session_path, alert: I18n.t(key)
+  end
+end

diff --git a/lib/oidc_login.rb b/lib/oidc_login.rb
new file mode 100644
index 0000000..051ac34
--- /dev/null
+++ b/lib/oidc_login.rb
@@ -0,0 +1,273 @@
+# frozen_string_literal: true
+
+# Generic OpenID Connect login (authorization code flow with PKCE) for the
+# self-hosted Community Edition (DocuSeal-Docker patch set). Own code, it does not
+# use or unlock DocuSeal Pro features. Only the jwt and faraday gems that DocuSeal
+# already ships are used.
+#
+# Inactive unless OIDC_ISSUER, OIDC_CLIENT_ID and OIDC_CLIENT_SECRET are set.
+#
+#   OIDC_ISSUER                 e.g. https://iam.example.com/application/o/contract/
+#   OIDC_CLIENT_ID / OIDC_CLIENT_SECRET
+#   OIDC_BUTTON_LABEL           login button text                       (Sign in with SSO)
+#   OIDC_SCOPES                                                         (openid email profile)
+#   OIDC_ALLOWED_GROUPS         comma separated; empty = every user the IdP lets through
+#   OIDC_GROUPS_CLAIM                                                   (groups)
+#   OIDC_CREATE_USERS           create missing users on first login     (true)
+#   OIDC_TRUST_EMAIL            accept email without email_verified=true (false)
+#   OIDC_ALLOW_PASSWORD_FOR_SSO_USERS  linked users may still use password login/reset (false)
+#
+# Users are matched by e-mail and then bound to the IdP subject (user_configs
+# key "oidc_sub"); a different subject for the same e-mail is rejected.
+module OidcLogin
+  class Error < StandardError; end
+
+  SESSION_KEY = 'oidc_login'
+  SUB_KEY = 'oidc_sub'
+  ARCHIVED_KEY = 'oidc_archived'
+  CACHE_TTL = 1.hour
+  HTTP_TIMEOUT = 10
+
+  module_function
+
+  def env(key, default = nil)
+    ENV.fetch(key, '').strip.presence || default
+  end
+
+  def enabled?
+    issuer.present? && client_id.present? && client_secret.present?
+  end
+
+  def partially_configured?
+    !enabled? && [issuer, client_id, client_secret].any?(&:present?)
+  end
+
+  def issuer
+    env('OIDC_ISSUER')
+  end
+
+  def client_id
+    env('OIDC_CLIENT_ID')
+  end
+
+  def client_secret
+    env('OIDC_CLIENT_SECRET')
+  end
+
+  def button_label
+    env('OIDC_BUTTON_LABEL', 'Sign in with SSO')
+  end
+
+  def scopes
+    env('OIDC_SCOPES', 'openid email profile')
+  end
+
+  def allowed_groups
+    env('OIDC_ALLOWED_GROUPS', '').split(',').map(&:strip).compact_blank
+  end
+
+  def groups_claim
+    env('OIDC_GROUPS_CLAIM', 'groups')
+  end
+
+  def create_users?
+    env('OIDC_CREATE_USERS', 'true') == 'true'
+  end
+
+  def trust_email?
+    env('OIDC_TRUST_EMAIL') == 'true'
+  end
+
+  def password_login_for_sso_users?
+    env('OIDC_ALLOW_PASSWORD_FOR_SSO_USERS') == 'true'
+  end
+
+  # --- provider metadata ----------------------------------------------------
+
+  def http
+    Faraday.new(request: { timeout: HTTP_TIMEOUT, open_timeout: HTTP_TIMEOUT }) do |f|
+      f.response :raise_error
+    end
+  end
+
+  def discovery(force: false)
+    @discovery = nil if force || (@discovery_at && @discovery_at < CACHE_TTL.ago)
+    @discovery ||= begin
+      url = "#{issuer.chomp('/')}/.well-known/openid-configuration"
+      data = JSON.parse(http.get(url).body)
+      %w[issuer authorization_endpoint token_endpoint jwks_uri].each do |key|
+        raise Error, "discovery document lacks #{key}" if data[key].blank?
+      end
+      @discovery_at = Time.current
+      data
+    end
+  end
+
+  def healthy?
+    enabled? && discovery.present?
+  rescue StandardError => e
+    Rails.logger.warn("[oidc] discovery failed: #{e.class}: #{e.message}")
+    false
+  end
+
+  def jwks(force: false)
+    @jwks = nil if force || (@jwks_at && @jwks_at < CACHE_TTL.ago)
+    @jwks ||= begin
+      set = JWT::JWK::Set.new(JSON.parse(http.get(discovery['jwks_uri']).body))
+      @jwks_at = Time.current
+      set
+    end
+  end
+
+  # --- flow -------------------------------------------------------------------
+
+  def code_challenge(verifier)
+    Base64.urlsafe_encode64(Digest::SHA256.digest(verifier), padding: false)
+  end
+
+  def authorize_url(redirect_uri:, state:, nonce:, verifier:)
+    query = {
+      response_type: 'code', client_id:, redirect_uri:, scope: scopes, state:, nonce:,
+      code_challenge: code_challenge(verifier), code_challenge_method: 'S256'
+    }
+
+    "#{discovery['authorization_endpoint']}?#{query.to_query}"
+  end
+
+  def exchange_code(code, redirect_uri:, verifier:)
+    resp = http.post(discovery['token_endpoint']) do |req|
+      req.headers['Authorization'] = "Basic #{Base64.strict_encode64("#{client_id}:#{client_secret}")}"
+      req.headers['Content-Type'] = 'application/x-www-form-urlencoded'
+      req.body = URI.encode_www_form(grant_type: 'authorization_code', code:, redirect_uri:, code_verifier: verifier)
+    end
+
+    JSON.parse(resp.body)
+  end
+
+  def verify_id_token(id_token, nonce:)
+    raise Error, 'no id_token in token response' if id_token.blank?
+
+    loader = lambda do |options|
+      jwks(force: true) if options[:kid_not_found]
+      jwks
+    end
+
+    claims, = JWT.decode(id_token, nil, true, algorithms: %w[RS256 ES256], jwks: loader,
+                                               iss: discovery['issuer'], verify_iss: true,
+                                               aud: client_id, verify_aud: true)
+
+    raise Error, 'nonce mismatch' unless ActiveSupport::SecurityUtils.secure_compare(claims['nonce'].to_s, nonce.to_s)
+    raise Error, 'id_token without sub' if claims['sub'].blank?
+
+    claims
+  end
+
+  def userinfo(access_token)
+    return {} if access_token.blank? || discovery['userinfo_endpoint'].blank?
+
+    JSON.parse(http.get(discovery['userinfo_endpoint'], nil, { 'Authorization' => "Bearer #{access_token}" }).body)
+  end
+
+  # --- users -------------------------------------------------------------------
+
+  def linked_sub(user)
+    UserConfig.find_by(user:, key: SUB_KEY)&.value
+  end
+
+  def sso_user?(user)
+    user.present? && linked_sub(user).present?
+  end
+
+  def groups_from(claims)
+    Array(claims[groups_claim]).map(&:to_s)
+  end
+
+  def allowed?(claims)
+    allowed_groups.empty? || groups_from(claims).intersect?(allowed_groups)
+  end
+
+  # Returns [user, nil] or [nil, error_key]
+  def resolve_user(claims)
+    email = claims['email'].to_s.strip.downcase
+    sub = claims['sub'].to_s
+
+    return [nil, :oidc_error_no_email] if email.blank?
+    return [nil, :oidc_error_email_unverified] unless trust_email? || claims['email_verified'] == true
+
+    user = User.find_by(email:)
+    linked = user && linked_sub(user)
+
+    return [nil, :oidc_error_subject_mismatch] if linked.present? && linked != sub
+
+    unless allowed?(claims)
+      archive_sso_user(user) if linked.present?
+
+      return [nil, :oidc_error_not_allowed]
+    end
+
+    return create_user(email:, sub:, claims:) unless user
+
+    if user.archived_at?
+      return [nil, :oidc_error_archived] unless UserConfig.exists?(user:, key: ARCHIVED_KEY)
+
+      user.update!(archived_at: nil)
+      UserConfig.where(user:, key: ARCHIVED_KEY).delete_all
+      Rails.logger.info("[oidc] user #{user.id} reactivated (back in an allowed group)")
+    end
+
+    if user.access_locked?
+      # The Devise lock protects the password login. A linked SSO user has none, so the
+      # lock must not block SSO (else failed password guesses could lock users out).
+      return [nil, :oidc_error_locked] if linked.blank? || password_login_for_sso_users?
+
+      user.unlock_access!
+    end
+
+    link(user, sub) if linked.blank?
+
+    [user, nil]
+  end
+
+  def create_user(email:, sub:, claims:)
+    return [nil, :oidc_error_no_account] unless create_users?
+
+    account = Account.order(:id).first
+    return [nil, :oidc_error_no_account] unless account
+
+    first_name, last_name = split_name(claims)
+
+    user = account.users.create!(email:, first_name:, last_name:, role: User::ADMIN_ROLE,
+                                 password: SecureRandom.base58(48))
+    link(user, sub)
+
+    Rails.logger.info("[oidc] user #{user.id} created on first SSO login")
+
+    [user, nil]
+  end
+
+  # Some IdPs (Authentik) send the full name as given_name and no family_name
+  def split_name(claims)
+    given = claims['given_name'].to_s.strip
+    family = claims['family_name'].to_s.strip
+    full = claims['name'].to_s.strip
+
+    return [given, family] if given.present? && family.present? && given != full
+
+    parts = (full.presence || given).split
+
+    [parts.first, parts.drop(1).join(' ').presence]
+  end
+
+  def link(user, sub)
+    UserConfig.find_or_initialize_by(user:, key: SUB_KEY).update!(value: sub)
+  end
+
+  def archive_sso_user(user)
+    return if user.archived_at?
+
+    user.update!(archived_at: Time.current)
+    UserConfig.find_or_initialize_by(user:, key: ARCHIVED_KEY).update!(value: true)
+
+    Rails.logger.info("[oidc] user #{user.id} archived (no longer in an allowed group)")
+  end
+end
-- 

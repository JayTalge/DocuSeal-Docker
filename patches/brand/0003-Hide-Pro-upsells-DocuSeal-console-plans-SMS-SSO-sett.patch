diff --git a/public/brand-base/hide-upsells.css b/public/brand-base/hide-upsells.css
new file mode 100644
index 00000000..5c144a5b
--- /dev/null
+++ b/public/brand-base/hide-upsells.css
@@ -0,0 +1,28 @@
+/* Hides DocuSeal Pro upsells (patch 0003). Pro features stay locked; they are only no longer advertised.
+   The upsell links are matched by their target URL instead of editing the upstream templates,
+   so changes to the surrounding conditions upstream do not break the patch on updates.
+   Never match Docuseal::PRODUCT_URL itself: the "Powered by DocuSeal" attribution must stay visible. */
+
+/* plans, console, embedding and "learn more" links (console_redirect, docuseal.com sign-up, console) */
+a[href*="/console_redirect"],
+a[href^="https://docuseal.com/sign_up"],
+a[href^="https://console.docuseal.com"],
+/* pricing and Pro-service links in the template builder */
+a[href^="https://www.docuseal.com/pricing"],
+a[href^="https://www.docuseal.com/qualified-electronic-signature"],
+a[href^="https://www.docuseal.com/blog/accept-payments"],
+/* settings navigation: Plans/Console items, SMS and SSO (Pro-only placeholder pages) */
+li:has(> a[href*="/console_redirect"]),
+li:has(> a[href^="https://docuseal.com/sign_up"]),
+li:has(> a[href^="https://console.docuseal.com"]),
+li:has(> a[href$="/settings/sms"]),
+li:has(> a[href$="/settings/sso"]),
+/* locked field tiles in the template builder (phone/SMS, qualified signature) and the "Send SMS" button */
+.tooltip:has(> a[href^="https://www.docuseal.com/"]),
+div:has(> .tooltip > a[href*="/console_redirect"]),
+div:has(> .tooltip > a[href^="https://docuseal.com/sign_up"]),
+/* "Get the DocuSeal app" banner for signed-in users on iOS/Android (since 3.3.6) */
+div:has(> span > a[href^="https://apps.apple.com/us/app/docuseal"]),
+div:has(> span > a[href^="https://play.google.com/store/apps/details?id=com.docuseal"]) {
+  display: none !important;
+}

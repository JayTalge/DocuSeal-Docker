From db2a8af195a53b0af9c37b2d7024e7ca33f73c20 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Thu, 29 Oct 2026 17:23:22 +0100
Subject: [PATCH 5/8] Source code link (AGPL-3.0 section 13) next to the
 DocuSeal attribution

From the JT patch 0007. Target is BRAND_SOURCE_URL (default: this repo),
/source redirects there.
---
 app/javascript/submission_form/completed.vue | 6 ++++++
 app/javascript/submission_form/i18n.js       | 2 ++
 app/views/shared/_powered_by.html.erb        | 1 +
 config/locales/i18n.yml                      | 2 ++
 config/routes.rb                             | 2 ++
 5 files changed, 13 insertions(+)

diff --git a/app/javascript/submission_form/completed.vue b/app/javascript/submission_form/completed.vue
index d44f9d2..d54abf7 100644
--- a/app/javascript/submission_form/completed.vue
+++ b/app/javascript/submission_form/completed.vue
@@ -106,6 +106,12 @@
         target="_blank"
         class="underline"
       >DocuSeal</a> - {{ t('open_source_documents_software') }}
+      · <a
+        href="/source"
+        target="_blank"
+        rel="noopener"
+        class="underline"
+      >{{ t('source_code') }}</a>
     </div>
   </div>
 </template>
diff --git a/app/javascript/submission_form/i18n.js b/app/javascript/submission_form/i18n.js
index e349e56..73421b6 100644
--- a/app/javascript/submission_form/i18n.js
+++ b/app/javascript/submission_form/i18n.js
@@ -89,6 +89,7 @@ const en = {
   powered_by: 'Powered by',
   please_check_the_box_to_continue: 'Please check the box to continue.',
   open_source_documents_software: 'open source documents software',
+  source_code: 'Source code',
   verified_phone_number: 'Verify Phone Number',
   country_code: 'Country code',
   use_international_format: 'Use international format: +1xxx',
@@ -449,6 +450,7 @@ const de = {
   powered_by: 'Bereitgestellt von',
   please_check_the_box_to_continue: 'Bitte aktivieren Sie das Kontrollkästchen, um fortzufahren.',
   open_source_documents_software: 'Open-Source-Dokumentensoftware',
+  source_code: 'Quellcode',
   verified_phone_number: 'Telefonnummer verifizieren',
   country_code: 'Ländervorwahl',
   use_international_format: 'Internationales Format verwenden: +1xxx',
diff --git a/app/views/shared/_powered_by.html.erb b/app/views/shared/_powered_by.html.erb
index dcb7925..394169f 100644
--- a/app/views/shared/_powered_by.html.erb
+++ b/app/views/shared/_powered_by.html.erb
@@ -1,4 +1,5 @@
 <div class="text-center px-2">
   <%= t('powered_by') %>
   <a href="<%= Docuseal::PRODUCT_URL %><%= local_assigns[:link_path] %>" class="underline">DocuSeal</a> - <%= t('open_source_documents_software') %>
+  · <a href="<%= Brand.source_url %>" class="underline" target="_blank" rel="noopener"><%= t('source_code', default: 'Source code') %></a>
 </div>
diff --git a/config/locales/i18n.yml b/config/locales/i18n.yml
index 00817eb..c411e37 100644
--- a/config/locales/i18n.yml
+++ b/config/locales/i18n.yml
@@ -732,6 +732,7 @@ en: &en
   upload_list: Upload List
   creating: Creating
   open_source_documents_software: open source documents software
+  source_code: Source code
   copy_link: Copy Link
   opened: Opened
   sent: Sent
@@ -6530,6 +6531,7 @@ de: &de
   upload_list: Liste hochladen
   creating: Erstellen
   open_source_documents_software: Open-Source-Dokumentensoftware
+  source_code: Quellcode
   copy_link: Link kopieren
   opened: Geöffnet
   sent: Gesendet
diff --git a/config/routes.rb b/config/routes.rb
index 812581a..c6a516e 100644
--- a/config/routes.rb
+++ b/config/routes.rb
@@ -12,6 +12,8 @@ Rails.application.routes.draw do
   root 'dashboard#index'
 
   get 'up' => 'rails/health#show'
+  # Corresponding Source (AGPL-3.0 section 13), see lib/brand.rb
+  get 'source' => redirect { Brand.source_url }
   get 'manifest' => 'pwa#manifest'
 
   devise_for :users, path: '/', only: %i[sessions passwords],
-- 

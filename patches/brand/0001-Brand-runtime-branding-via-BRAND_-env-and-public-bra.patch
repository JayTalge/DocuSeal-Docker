diff --git a/config/initializers/zz_brand.rb b/config/initializers/zz_brand.rb
new file mode 100644
index 0000000..022e2ee
--- /dev/null
+++ b/config/initializers/zz_brand.rb
@@ -0,0 +1,35 @@
+# frozen_string_literal: true
+
+# Runtime branding, see lib/brand.rb (DocuSeal-Docker patch set).
+Rails.application.config.to_prepare do
+  Docuseal.singleton_class.send(:define_method, :product_name) { Brand.product_name } if Brand.configured?
+end
+
+Rails.application.config.after_initialize do
+  # Language for pages without an account context (landing page, login): BRAND_DEFAULT_LOCALE=de-DE
+  default_locale = Brand.env('BRAND_DEFAULT_LOCALE')
+  I18n.default_locale = default_locale.to_sym if default_locale && I18n.available_locales.include?(default_locale.to_sym)
+
+  # Load the YAML files first, otherwise they would overwrite the strings stored here.
+  I18n.backend.send(:init_translations) unless I18n.backend.initialized?
+
+  support_en = "If you have any questions, email #{Brand.support_email}."
+  support_de = "Bei Fragen schreiben Sie an #{Brand.support_email}."
+
+  { en: [support_en, 'Welcome to'], de: [support_de, 'Willkommen bei'] }.each do |locale, (support, welcome)|
+    Brand.store_translations(locale, welcome_to_docuseal: "#{welcome} #{Brand.product_name}",
+                                            app_tour: { support_description: support })
+  end
+
+  Brand.store_translations(:en, brand_imprint: 'Imprint', brand_privacy: 'Privacy', brand_terms: 'Terms of use',
+                                       brand_landing_hint: 'Received a signature request? Please use the link from your email.')
+  Brand.store_translations(:de, brand_imprint: 'Impressum', brand_privacy: 'Datenschutz',
+                                       brand_terms: 'Nutzungsbedingungen',
+                                       brand_landing_hint: 'Sie haben eine Signaturanfrage erhalten? ' \
+                                                           'Bitte nutzen Sie den Link aus Ihrer E-Mail.')
+
+  missing = Brand.missing_assets
+  Rails.logger.info("[brand] name=#{Brand.name.inspect} configured=#{Brand.configured?} " \
+                    "assets=#{missing.empty? ? 'ok' : "MISSING #{missing.join(',')}"}")
+  warn "[brand] WARN brand pack incomplete, missing: #{missing.join(', ')}" if Brand.configured? && missing.any?
+end
diff --git a/lib/brand.rb b/lib/brand.rb
new file mode 100644
index 0000000..26ed343
--- /dev/null
+++ b/lib/brand.rb
@@ -0,0 +1,138 @@
+# frozen_string_literal: true
+
+# Runtime branding for self-hosted instances (DocuSeal-Docker patch set).
+#
+# Everything is configured through environment variables, the images/CSS come
+# from public/brand/ (bind-mount a brand pack over it). Without any BRAND_* variable
+# the instance looks like a neutral DocuSeal.
+#
+#   BRAND_NAME            short name shown in titles, PDF header, mails   (DocuSeal)
+#   BRAND_PRODUCT_NAME    product name (Docuseal.product_name)            (BRAND_NAME)
+#   BRAND_COMPANY         legal entity for footers                        (BRAND_NAME)
+#   BRAND_TITLE           default page title                              ("<name> | <tagline>")
+#   BRAND_TAGLINE         e.g. "Elektronische Signatur"
+#   BRAND_DESCRIPTION     meta description / landing text
+#   BRAND_SUPPORT_EMAIL   replaces support@docuseal.com
+#   BRAND_IMPRINT_URL / BRAND_PRIVACY_URL / BRAND_TERMS_URL   footer links (optional)
+#   BRAND_DEFAULT_LOCALE  language without account context, e.g. de-DE  (en)
+#   BRAND_THEME_COLOR     <meta name="theme-color"> / PWA colour          (#0E0F1F)
+#   BRAND_ASSET_VERSION   cache buster for /brand/* URLs                  (1)
+#   BRAND_SOURCE_URL      Corresponding Source (AGPL-3.0 section 13)
+module Brand
+  DEFAULT_SOURCE_URL = 'https://github.com/JayTalge/DocuSeal-Docker'
+  ASSET_DIR = Rails.root.join('public/brand')
+  BASE_CSS_VERSION = '1'
+
+  # Files the brand pack is expected to provide (checked by /healthz/brand).
+  REQUIRED_ASSETS = %w[logo.svg logo-light.svg icon.svg favicon.svg favicon-32x32.png apple-touch-icon.png
+                       pdf-logo.png stamp-logo.png brand.css].freeze
+
+  module_function
+
+  def env(key, default = nil)
+    ENV.fetch(key, '').strip.presence || default
+  end
+
+  def configured?
+    env('BRAND_NAME').present?
+  end
+
+  def name
+    env('BRAND_NAME', 'DocuSeal')
+  end
+
+  def product_name
+    env('BRAND_PRODUCT_NAME', name)
+  end
+
+  def company
+    env('BRAND_COMPANY', name)
+  end
+
+  def tagline
+    env('BRAND_TAGLINE', 'Open Source Document Signing')
+  end
+
+  def title
+    env('BRAND_TITLE', "#{name} | #{tagline}")
+  end
+
+  def description
+    env('BRAND_DESCRIPTION', 'Sign documents securely and conveniently online.')
+  end
+
+  def support_email
+    env('BRAND_SUPPORT_EMAIL', 'support@docuseal.com')
+  end
+
+  def imprint_url
+    env('BRAND_IMPRINT_URL')
+  end
+
+  def privacy_url
+    env('BRAND_PRIVACY_URL')
+  end
+
+  def terms_url
+    env('BRAND_TERMS_URL')
+  end
+
+  def theme_color
+    env('BRAND_THEME_COLOR', '#0E0F1F')
+  end
+
+  def source_url
+    env('BRAND_SOURCE_URL', DEFAULT_SOURCE_URL)
+  end
+
+  def sign_reason
+    "Signed with #{product_name}"
+  end
+
+  # URL path of a brand asset with cache buster, e.g. Brand.asset('logo.svg')
+  def asset(file)
+    "/brand/#{file}?v=#{env('BRAND_ASSET_VERSION', '1')}"
+  end
+
+  # Absolute URL of a brand asset (for e-mails)
+  def asset_url(file)
+    opts = Docuseal.default_url_options
+    port = ":#{opts[:port]}" if opts[:port].present? && ![80, 443].include?(opts[:port].to_i)
+    "#{opts[:protocol] || 'https'}://#{opts[:host]}#{port}#{asset(file)}"
+  end
+
+  def asset_path(file)
+    ASSET_DIR.join(file)
+  end
+
+  def asset?(file)
+    File.file?(asset_path(file))
+  end
+
+  def missing_assets
+    REQUIRED_ASSETS.reject { |f| asset?(f) }
+  end
+
+  # Footer links that are configured, as [[label_key, url], ...]
+  def legal_links
+    [[:imprint, imprint_url], [:privacy, privacy_url], [:terms, terms_url]].select { |_, url| url.present? }
+  end
+
+  # Language of the (single) account, for code that runs before the locale filters
+  def default_locale
+    locale = Account.order(:id).pick(:locale).presence
+    locale && I18n.available_locales.include?(locale.to_sym) ? locale : I18n.default_locale
+  end
+
+  # Store translations for a base locale and its regional copies (de-DE, en-US ...
+  # are YAML copies in config/locales/i18n.yml, not fallbacks).
+  def store_translations(locale, data)
+    I18n.available_locales.select { |l| l == locale || l.to_s.start_with?("#{locale}-") }.each do |l|
+      I18n.backend.store_translations(l, data)
+    end
+  end
+
+  def legal_label(key)
+    I18n.t("brand_#{key}", default: { imprint: 'Imprint', privacy: 'Privacy', terms: 'Terms' }[key])
+  end
+end

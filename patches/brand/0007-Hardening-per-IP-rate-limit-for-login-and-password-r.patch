From a2f90e211f56aca7e21789321b2a25b4a6f3cdd6 Mon Sep 17 00:00:00 2001
From: build <build@localhost>
Date: Thu, 29 Oct 2026 17:26:00 +0100
Subject: [PATCH 7/8] Hardening: per-IP rate limit for login and password
 reset, TRUSTED_PROXIES

- sessions#create: LOGIN_RATE_LIMIT attempts (10) per LOGIN_RATE_PERIOD_MINUTES (5)
  per client IP, password reset: 5 per 15 minutes
- TRUSTED_PROXIES restricts which proxies may set X-Forwarded-For and drops
  Client-IP headers, so the audit trail and the limits see the real client IP
---
 app/controllers/passwords_controller.rb  |  4 ++++
 app/controllers/sessions_controller.rb   |  8 ++++++++
 config/initializers/zz_security.rb       | 18 ++++++++++++++++++
 lib/drop_client_ip_headers_middleware.rb | 17 +++++++++++++++++
 4 files changed, 47 insertions(+)
 create mode 100644 config/initializers/zz_security.rb
 create mode 100644 lib/drop_client_ip_headers_middleware.rb

diff --git a/app/controllers/passwords_controller.rb b/app/controllers/passwords_controller.rb
index bc59584..5cc69d5 100644
--- a/app/controllers/passwords_controller.rb
+++ b/app/controllers/passwords_controller.rb
@@ -7,6 +7,10 @@ class PasswordsController < Devise::PasswordsController
 
   around_action :with_browser_locale
 
+  rate_limit to: 5, within: 15.minutes, only: :create, prepend: true, by: -> { request.remote_ip }, with: lambda {
+    redirect_to new_user_session_path, alert: I18n.t(:too_many_requests_try_again_later, locale: Brand.default_locale)
+  }
+
   class Current < ActiveSupport::CurrentAttributes
     attribute :user
   end
diff --git a/app/controllers/sessions_controller.rb b/app/controllers/sessions_controller.rb
index 4546885..e3d2c4a 100644
--- a/app/controllers/sessions_controller.rb
+++ b/app/controllers/sessions_controller.rb
@@ -7,6 +7,14 @@ class SessionsController < Devise::SessionsController
 
   respond_to :json, only: :create
 
+  # Per-IP limit against password guessing (Devise lockable only locks single accounts).
+  # Prepended, so it runs before Devise checks the password in require_no_authentication.
+  rate_limit to: ENV.fetch('LOGIN_RATE_LIMIT', 10).to_i, within: ENV.fetch('LOGIN_RATE_PERIOD_MINUTES', 5).to_i.minutes,
+             only: :create, prepend: true, by: -> { request.remote_ip }, with: lambda {
+               Rails.logger.warn("[security] login rate limit hit ip=#{request.remote_ip}")
+               redirect_to new_user_session_path, alert: I18n.t(:too_many_requests_try_again_later, locale: Brand.default_locale)
+             }
+
   around_action :with_browser_locale
 
   # Prepended: Devise already checks the password in require_no_authentication
diff --git a/config/initializers/zz_security.rb b/config/initializers/zz_security.rb
new file mode 100644
index 0000000..07793c9
--- /dev/null
+++ b/config/initializers/zz_security.rb
@@ -0,0 +1,18 @@
+# frozen_string_literal: true
+
+# Reverse proxy hardening (DocuSeal-Docker patch set).
+#
+#   TRUSTED_PROXIES=192.168.55.41   comma separated IPs/CIDRs of the reverse proxy.
+#   Only these (plus loopback) may set X-Forwarded-For, so request.remote_ip, the
+#   audit trail and the rate limits see the real client IP. Without the variable
+#   Rails' default (all private networks) applies.
+require_relative '../../lib/drop_client_ip_headers_middleware'
+
+proxies = ENV.fetch('TRUSTED_PROXIES', '').split(',').map(&:strip).compact_blank
+
+if proxies.any?
+  Rails.application.config.action_dispatch.trusted_proxies =
+    (proxies + %w[127.0.0.1 ::1]).map { |ip| IPAddr.new(ip) }
+
+  Rails.application.config.middleware.insert_before ActionDispatch::RemoteIp, DropClientIpHeadersMiddleware
+end
diff --git a/lib/drop_client_ip_headers_middleware.rb b/lib/drop_client_ip_headers_middleware.rb
new file mode 100644
index 0000000..0cbd9e6
--- /dev/null
+++ b/lib/drop_client_ip_headers_middleware.rb
@@ -0,0 +1,17 @@
+# frozen_string_literal: true
+
+# With TRUSTED_PROXIES set, the client IP comes from X-Forwarded-For of those
+# proxies only. Client-IP headers sent by the browser are dropped so they can
+# neither spoof the IP nor trigger IP spoofing errors (DocuSeal-Docker patch set).
+class DropClientIpHeadersMiddleware
+  def initialize(app)
+    @app = app
+  end
+
+  def call(env)
+    env.delete('HTTP_CLIENT_IP')
+    env.delete('HTTP_X_CLIENT_IP')
+
+    @app.call(env)
+  end
+end

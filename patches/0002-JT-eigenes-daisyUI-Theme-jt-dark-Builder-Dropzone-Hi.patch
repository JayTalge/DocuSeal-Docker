From 932c1c6477a571f966c22aacb75244fb2786996c Mon Sep 17 00:00:00 2001
From: JT DocuSeal Build <kontakt@jason-talge.de>
Date: Fri, 23 Oct 2026 19:55:44 +0200
Subject: [PATCH 2/7] JT: eigenes daisyUI-Theme jt (dark),
 Builder-/Dropzone-Hintergrund folgt dem Theme

---
 app/javascript/application.js                 |  2 +-
 app/javascript/elements/dashboard_dropzone.js |  2 +-
 app/javascript/elements/file_dropzone.js      |  2 +-
 app/views/layouts/application.html.erb        |  2 +-
 app/views/layouts/form.html.erb               |  2 +-
 app/views/layouts/plain.html.erb              |  2 +-
 .../submit_form_draw_signature/show.html.erb  |  2 +-
 tailwind.config.js                            | 29 ++++++++++++-------
 8 files changed, 26 insertions(+), 17 deletions(-)

diff --git a/app/javascript/application.js b/app/javascript/application.js
index a08c858..689da0e 100644
--- a/app/javascript/application.js
+++ b/app/javascript/application.js
@@ -229,7 +229,7 @@ safeRegisterElement('template-builder', class extends HTMLElement {
       customFields: reactive(JSON.parse(this.dataset.customFields || '[]')),
       dateFormats: JSON.parse(this.dataset.dateFormats || '[]'),
       dynamicDocuments: reactive(JSON.parse(this.dataset.dynamicDocuments || '[]')),
-      backgroundColor: '#faf7f5',
+      backgroundColor: 'hsl(var(--b1))',
       locale: this.dataset.locale,
       withPhone: this.dataset.withPhone === 'true',
       withPrefillable: template.fields?.some((f) => f.prefillable),
diff --git a/app/javascript/elements/dashboard_dropzone.js b/app/javascript/elements/dashboard_dropzone.js
index 8aa75c0..cb872ca 100644
--- a/app/javascript/elements/dashboard_dropzone.js
+++ b/app/javascript/elements/dashboard_dropzone.js
@@ -203,7 +203,7 @@ export default targetable(class extends HTMLElement {
     if (!el) return
 
     if (e.dataTransfer?.types?.includes('Files') || el.dataset.targets !== 'dashboard-dropzone.templateCards') {
-      el.style.backgroundColor = '#F7F3F0'
+      el.style.backgroundColor = 'hsl(var(--b2))'
 
       if (el.classList.contains('before:border-base-300')) {
         el.classList.remove('before:border-base-300')
diff --git a/app/javascript/elements/file_dropzone.js b/app/javascript/elements/file_dropzone.js
index ad7843e..d2dc64d 100644
--- a/app/javascript/elements/file_dropzone.js
+++ b/app/javascript/elements/file_dropzone.js
@@ -36,7 +36,7 @@ export default actionable(targetable(class extends HTMLElement {
 
   onDragover (e) {
     if (e.dataTransfer?.types?.includes('Files')) {
-      this.style.backgroundColor = '#F7F3F0'
+      this.style.backgroundColor = 'hsl(var(--b2))'
       this.classList.remove('border-base-300', 'hover:bg-base-200/30')
       this.classList.add('border-base-content/30')
     }
diff --git a/app/views/layouts/application.html.erb b/app/views/layouts/application.html.erb
index cf5afe1..b2688c5 100644
--- a/app/views/layouts/application.html.erb
+++ b/app/views/layouts/application.html.erb
@@ -1,5 +1,5 @@
 <!DOCTYPE html>
-<html data-theme="docuseal" lang="<%= I18n.locale %>">
+<html data-theme="jt" lang="<%= I18n.locale %>">
   <head>
     <%= render 'layouts/head_tags' %>
     <% if Docuseal.enable_pwa? %>
diff --git a/app/views/layouts/form.html.erb b/app/views/layouts/form.html.erb
index 400b0bd..641fb99 100644
--- a/app/views/layouts/form.html.erb
+++ b/app/views/layouts/form.html.erb
@@ -1,5 +1,5 @@
 <!DOCTYPE html>
-<html data-theme="docuseal" lang="<%= I18n.locale %>">
+<html data-theme="jt" lang="<%= I18n.locale %>">
   <head>
     <%= render 'layouts/head_tags' %>
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
diff --git a/app/views/layouts/plain.html.erb b/app/views/layouts/plain.html.erb
index f23f9b2..92465de 100644
--- a/app/views/layouts/plain.html.erb
+++ b/app/views/layouts/plain.html.erb
@@ -1,5 +1,5 @@
 <!DOCTYPE html>
-<html data-theme="docuseal" lang="<%= I18n.locale %>">
+<html data-theme="jt" lang="<%= I18n.locale %>">
   <head>
     <%= render 'layouts/head_tags' %>
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
diff --git a/app/views/submit_form_draw_signature/show.html.erb b/app/views/submit_form_draw_signature/show.html.erb
index f1ffebf..81ee52a 100644
--- a/app/views/submit_form_draw_signature/show.html.erb
+++ b/app/views/submit_form_draw_signature/show.html.erb
@@ -1,5 +1,5 @@
 <!DOCTYPE html>
-<html data-theme="docuseal" lang="en">
+<html data-theme="jt" lang="en">
   <head>
     <%= render 'layouts/head_tags' %>
     <meta name="viewport" content="width=device-width, initial-scale=1.0">
diff --git a/tailwind.config.js b/tailwind.config.js
index e3d5576..9740ad5 100644
--- a/tailwind.config.js
+++ b/tailwind.config.js
@@ -8,16 +8,25 @@ module.exports = {
   daisyui: {
     themes: [
       {
-        docuseal: {
-          'color-scheme': 'light',
-          primary: '#e4e0e1',
-          secondary: '#ef9fbc',
-          accent: '#eeaf3a',
-          neutral: '#291334',
-          'base-100': '#faf7f5',
-          'base-200': '#efeae6',
-          'base-300': '#e7e2df',
-          'base-content': '#291334',
+        // JT Dark (Palette wie Jitsi-Dark): Body #061A2E, Karten #0B2A4A, Buttons #2F6EB1
+        jt: {
+          'color-scheme': 'dark',
+          primary: '#214163',
+          'primary-focus': '#29507A',
+          'primary-content': '#E3EAF2',
+          secondary: '#699CD3',
+          'secondary-focus': '#4988CA',
+          'secondary-content': '#061A2E',
+          accent: '#4394D6',
+          'accent-focus': '#2C82C9',
+          'accent-content': '#061A2E',
+          neutral: '#2F6EB1',
+          'neutral-focus': '#285D95',
+          'neutral-content': '#FFFFFF',
+          'base-100': '#061A2E',
+          'base-200': '#0B2A4A',
+          'base-300': '#143457',
+          'base-content': '#DDE5EE',
           '--rounded-btn': '1.9rem',
           '--tab-border': '2px',
           '--tab-radius': '.5rem'
-- 
2.43.0

